# Omit both for local defaults. Set APP_ENV=production on Render.
APP_ENV=
# Comma-separated exact frontend origins, without trailing slashes.
CORS_ALLOWED_ORIGINS=
# Optional demo storage ceilings; omit for defaults. Positive integers only.
MAX_ACTIVE_SESSIONS=100
MAX_MOCK_TICKETS=100
MAX_REFINEMENT_HISTORY_QUESTIONS=40

# Proxy trust is opt-in. Keep empty until Render ingress contract is verified.
# Start Uvicorn with --no-proxy-headers; the app resolves trusted hops itself.
TRUSTED_PROXY_CIDRS=
# OPENAI_MODEL defaults to the only reviewed pricing profile:
# OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# The $4 in-memory budget resets on restart; see docs/ABUSE_PROTECTION.md.
